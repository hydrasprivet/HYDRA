local minScale, hardMaxScale = 0.60, 1.30
local chosenScale = math.clamp(tonumber(tbl2.InterfaceScale) or 1, minScale, hardMaxScale)
local function screenMaxScale()
    local camera = workspace.CurrentCamera
    if not camera then return 1 end
    local viewport = camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then return 1 end
    return math.clamp(math.min((viewport.X - 30)/820, (viewport.Y - 30)/508), .42, hardMaxScale)
end
local function renderScale()
    local actual = math.min(chosenScale, screenMaxScale())
    sizeScaler.Scale = actual
    sizePercent.Text = tostring(math.floor(actual * 100 + .5)) .. "%"
    local screenMax = screenMaxScale()
    local lower = math.min(minScale, screenMax)
    local progress = (screenMax > lower + .001) and math.clamp((actual - lower)/(screenMax - lower), 0, 1) or 1
    sliderFill.Size = UDim2.fromScale(progress, 1)
    sliderHandle.Position = UDim2.new(progress, -6, .5, -6)
    -- Existing show/hide animations reference these two positions.
    -- UIScale changes the actual visual dimensions, so recenter using scaled pixels.
    udim2 = UDim2.new(.5, -410*actual, .5, -254*actual)
    udim22 = UDim2.new(.5, -410*actual, 1.5, 0)
    if frame.Visible and flag then
        frame.Position = udim2
    end
end
local function changeScale(requested)
    local allowed = screenMaxScale()
    local lower = math.min(minScale, allowed)
    chosenScale = math.clamp(math.floor(requested*100 + .5)/100, lower, allowed)
    tbl2.InterfaceScale = chosenScale
    renderScale()
end

zoomMinus.MouseButton1Click:Connect(function()
    changeScale(chosenScale - .05)
end)
zoomPlus.MouseButton1Click:Connect(function()
    changeScale(chosenScale + .05)
end)

local sliderDragging = false
local function slideTo(input)
    local width = sliderTrack.AbsoluteSize.X
    if width < 1 then return end
    local amount = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / width, 0, 1)
    local currentMax = screenMaxScale()
    local lower = math.min(minScale, currentMax)
    changeScale(lower + amount*(currentMax-lower))
end
sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        slideTo(input)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
